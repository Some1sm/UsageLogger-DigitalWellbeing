<Page
    x:Class="UsageLogger.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UsageLogger.Views"
    xmlns:vm="using:UsageLogger.ViewModels"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    xmlns:controls="using:UsageLogger.Controls"
    xmlns:helpers="using:UsageLogger.Helpers"
    xmlns:converters="using:UsageLogger.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:PercentConverter x:Key="PercentConverter"/>
        <converters:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter"/>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Controls Header -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                
                <!-- Time Period Dropdown -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="History_TimePeriod" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding DateRangeOptions}" SelectedIndex="{Binding SelectedDateRangeIndex, Mode=TwoWay}" Width="130"/>
                </StackPanel>
                
                <!-- View Mode Dropdown -->
                <StackPanel Spacing="4">
                    <TextBlock l:Uids.Uid="History_ViewMode" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding ViewModeOptions}" SelectedIndex="{Binding SelectedViewModeIndex, Mode=TwoWay}" Width="120"/>
                </StackPanel>
                
                <!-- Custom Date Range Controls (visible only when Custom is selected) -->
                <StackPanel Orientation="Horizontal" Spacing="15" Visibility="{Binding IsCustomDateRange}">
                    
                    <!-- Separator -->
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="5,0"/>
                    
                    <!-- Start Date -->
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="History_StartDate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <CalendarDatePicker Date="{Binding StartDate, Mode=TwoWay}" Width="140"/>
                    </StackPanel>
                    
                    <!-- End Date -->
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="History_EndDate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <CalendarDatePicker Date="{Binding EndDate, Mode=TwoWay}" Width="140"/>
                    </StackPanel>
                    
                    <!-- Generate Button -->
                    <Button l:Uids.Uid="History_ApplyButton" Command="{x:Bind ViewModel.GenerateChartCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="20,6"/>
                </StackPanel>

                <!-- Separator -->
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="5,0"/>

                <!-- Generate Visual Report / Infographic -->
                <Button x:Name="BtnVisualReport" 
                        Click="BtnVisualReport_Click" 
                        VerticalAlignment="Bottom" 
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📸" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtVisualReport" l:Uids.Uid="History_VisualReportText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Export Data (CSV / JSON) -->
                <DropDownButton x:Name="BtnExportData" VerticalAlignment="Bottom" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtExportButton" l:Uids.Uid="History_ExportButton" Text="Export Data" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem l:Uids.Uid="History_ExportCsv" Text="Export as CSV..." Click="BtnExportCsv_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem l:Uids.Uid="History_ExportJson" Text="Export as JSON..." Click="BtnExportJson_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE943;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                
            </StackPanel>
        </Border>

        <!-- Scrollable Content Area -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                
                <!-- Error Message Banner -->
                <InfoBar IsOpen="{Binding HasError, Mode=OneWay}" Severity="Error" Title="Error" Message="{Binding ErrorMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,10" />

                <!-- KPI Summary Cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Total Time Card -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Active Time -->
                            <StackPanel Grid.Column="0">
                                <TextBlock l:Uids.Uid="History_TotalScreenTime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalHoursText, FallbackValue='00:00:00'}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalChangeText, FallbackValue='Generating...'}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <!-- Divider -->
                            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="15,4"/>

                            <!-- AFK Time -->
                            <StackPanel Grid.Column="2">
                                <TextBlock l:Uids.Uid="History_TotalAfkTime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AfkTimeText, FallbackValue='0m'}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Spacing="6" Opacity="0.6">
                                     <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                     <TextBlock l:Uids.Uid="History_AwayLock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Trend Info Card (Current Daily Avg | Previous Benchmark Avg) -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current Daily Average -->
                            <StackPanel Grid.Column="0">
                                <TextBlock l:Uids.Uid="History_DailyTrends" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentPeriodAvgText, FallbackValue='0h 0m'}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AvgChangeText, FallbackValue='...'}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="15,4"/>

                            <!-- Previous Daily Average (Benchmark) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock l:Uids.Uid="History_PrevPeriodAvgTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PrevPeriodAvgText, FallbackValue='0h 0m'}" FontSize="28" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Spacing="6" Opacity="0.6">
                                    <Rectangle Width="16" Height="2" Fill="Orange" VerticalAlignment="Center"/>
                                    <TextBlock l:Uids.Uid="History_DailyTrendsLegend" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Analytics Insights Row: Productivity, Context Switches, Day-Part Routine -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Productivity Balance -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock l:Uids.Uid="History_ProductivityTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.ProductivityScore, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="%" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 3-Segment Ratio Bar with Interactive Pointer Hover -->
                            <Border x:Name="ProdBarContainer" CornerRadius="8" Height="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" PointerEntered="ProdBar_PointerMoved" PointerMoved="ProdBar_PointerMoved" PointerExited="ProdBar_PointerExited" PointerCaptureLost="ProdBar_PointerExited">
                                <Grid x:Name="ProdBarGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind ViewModel.ProductivePercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{x:Bind ViewModel.NeutralPercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{x:Bind ViewModel.LeisurePercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#107C41" CornerRadius="8,0,0,8" ToolTipService.ToolTip="{x:Bind ViewModel.ProductiveTooltip, Mode=OneWay}"/>
                                    <Border Grid.Column="1" Background="#0078D4" ToolTipService.ToolTip="{x:Bind ViewModel.NeutralTooltip, Mode=OneWay}"/>
                                    <Border Grid.Column="2" Background="#8764B8" CornerRadius="0,8,8,0" ToolTipService.ToolTip="{x:Bind ViewModel.LeisureTooltip, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <!-- Dynamic Hover / Breakdown Status Text -->
                            <TextBlock x:Name="TxtProdHoverStatus" Text="{x:Bind ViewModel.ProductivityBreakdownText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                            <!-- Visual Color Dot Legend with Category Names & Durations -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{x:Bind ViewModel.ProductiveTooltip, Mode=OneWay}" PointerEntered="LegendProductive_PointerEntered" PointerExited="ProdBar_PointerExited">
                                    <Ellipse Width="7" Height="7" Fill="#107C41" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.ProductiveLabelText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.ProductiveDurationText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{x:Bind ViewModel.NeutralTooltip, Mode=OneWay}" PointerEntered="LegendNeutral_PointerEntered" PointerExited="ProdBar_PointerExited">
                                    <Ellipse Width="7" Height="7" Fill="#0078D4" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.NeutralLabelText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.NeutralDurationText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{x:Bind ViewModel.LeisureTooltip, Mode=OneWay}" PointerEntered="LegendLeisure_PointerEntered" PointerExited="ProdBar_PointerExited">
                                    <Ellipse Width="7" Height="7" Fill="#8764B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.LeisureLabelText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.LeisureDurationText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Focus & Context Switching -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock l:Uids.Uid="History_ContextSwitchesTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.SwitchesPerHourText, Mode=OneWay}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                    <TextBlock Text="{x:Bind ViewModel.FocusRatingText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Bottom Action: View Top Switched Apps -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.TotalSwitchesText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock l:Uids.Uid="History_AppSwitchesButton" Text="App switches"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="AppSwitchesFlyout" Opening="AppSwitchesFlyout_Opening" Opened="AppSwitchesFlyout_Opened">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                    <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Padding" Value="16"/>
                                                    <Setter Property="MinWidth" Value="280"/>
                                                    <Setter Property="MaxWidth" Value="360"/>
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock l:Uids.Uid="History_AppSwitchesBreakdown" Text="App Switch Count" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalSwitchesText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>

                                                <ListView ItemsSource="{x:Bind ViewModel.TopSwitchedApps, Mode=OneWay}" SelectionMode="None" MaxHeight="260">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="helpers:AppSwitchItem">
                                                            <Grid Padding="0,5" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image Grid.Column="0" Source="{x:Bind IconSource}" Width="20" Height="20" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Count}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                                    <TextBlock Text="{x:Bind Percentage, Converter={StaticResource PercentConverter}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Day-Part Routine -->
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock l:Uids.Uid="History_DayPartRoutineTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock l:Uids.Uid="History_LateNightLabel" Text="Late Night:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    <TextBlock Text="{x:Bind ViewModel.LateNightUsageText, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 4-Segment Routine Bar with Interactive Pointer Hover -->
                            <Border x:Name="DayPartBarContainer" CornerRadius="8" Height="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" PointerEntered="DayPartBar_PointerMoved" PointerMoved="DayPartBar_PointerMoved" PointerExited="DayPartBar_PointerExited" PointerCaptureLost="DayPartBar_PointerExited">
                                <Grid x:Name="DayPartBarGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind ViewModel.MorningPercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{x:Bind ViewModel.AfternoonPercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{x:Bind ViewModel.EveningPercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                        <ColumnDefinition Width="{x:Bind ViewModel.NightPercent, Mode=OneWay, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FFB900" CornerRadius="8,0,0,8" ToolTipService.ToolTip="{x:Bind ViewModel.MorningTooltip, Mode=OneWay}"/>
                                    <Border Grid.Column="1" Background="#0078D4" ToolTipService.ToolTip="{x:Bind ViewModel.AfternoonTooltip, Mode=OneWay}"/>
                                    <Border Grid.Column="2" Background="#E74856" ToolTipService.ToolTip="{x:Bind ViewModel.EveningTooltip, Mode=OneWay}"/>
                                    <Border Grid.Column="3" Background="#5C2D91" CornerRadius="0,8,8,0" ToolTipService.ToolTip="{x:Bind ViewModel.NightTooltip, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <!-- Dynamic Hover / Breakdown Status Text -->
                            <TextBlock x:Name="TxtDayPartHoverStatus" Text="{x:Bind ViewModel.DayPartBreakdownText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                            <!-- Visual Color Dot Legend with Routine Names & Durations -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" ToolTipService.ToolTip="{x:Bind ViewModel.MorningTooltip, Mode=OneWay}" PointerEntered="LegendMorning_PointerEntered" PointerExited="DayPartBar_PointerExited">
                                    <Ellipse Width="6" Height="6" Fill="#FFB900" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.MorningLabelText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.MorningDurationText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" ToolTipService.ToolTip="{x:Bind ViewModel.AfternoonTooltip, Mode=OneWay}" PointerEntered="LegendAfternoon_PointerEntered" PointerExited="DayPartBar_PointerExited">
                                    <Ellipse Width="6" Height="6" Fill="#0078D4" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.AfternoonLabelText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.AfternoonDurationText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" ToolTipService.ToolTip="{x:Bind ViewModel.EveningTooltip, Mode=OneWay}" PointerEntered="LegendEvening_PointerEntered" PointerExited="DayPartBar_PointerExited">
                                    <Ellipse Width="6" Height="6" Fill="#E74856" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.EveningLabelText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.EveningDurationText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" ToolTipService.ToolTip="{x:Bind ViewModel.NightTooltip, Mode=OneWay}" PointerEntered="LegendNight_PointerEntered" PointerExited="DayPartBar_PointerExited">
                                    <Ellipse Width="6" Height="6" Fill="#5C2D91" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.NightLabelText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.NightDurationText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Trend Chart -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock l:Uids.Uid="History_UsageTrends" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <controls:Win2DBarChart x:Name="TrendChartContainer" ItemsSource="{x:Bind ViewModel.TrendData, Mode=OneWay}" OverlaySource="{x:Bind ViewModel.SearchOverlayData, Mode=OneWay}" TargetLineValue="{x:Bind ViewModel.PreviousPeriodAverage, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="250"/>
                    </StackPanel>
                </Border>

                <!-- App Lookup -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock l:Uids.Uid="History_AppLookupTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Search -->
                            <StackPanel Grid.Column="0" Spacing="6">
                                <AutoSuggestBox x:Name="AppSearchBox" l:Uids.Uid="History_SearchPlaceholder" QueryIcon="Find"
                                                TextChanged="AppSearchBox_TextChanged" SuggestionChosen="AppSearchBox_SuggestionChosen" QuerySubmitted="AppSearchBox_QuerySubmitted"/>
                                <TextBlock Text="{Binding SearchResultText}" FontWeight="SemiBold" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="20,0"/>

                            <!-- Right: Top App -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock l:Uids.Uid="History_TopAppLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding TopAppText}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TopAppComparisonText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Opacity="0.7"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Distribution Analysis -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock l:Uids.Uid="History_DistributionAnalysis" FontSize="18" FontWeight="SemiBold"/>
                        <ContentControl x:Name="HistoryChartContainer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="350" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Activity Heatmap -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock l:Uids.Uid="History_ActivityHeatmap" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="History_HeatmapTooltip" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,10"/>
                        <controls:Win2DHeatmap x:Name="HeatMapContainer" ItemsSource="{x:Bind ViewModel.HeatMapData, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="250"/>
                    </StackPanel>
                </Border>
                
                <!-- Loading Indicator -->
                <ProgressRing IsActive="{Binding IsLoading}" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
